# Generic OpenAI-compatible endpoint. Examples:
# - OpenAI: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Any self-hosted or managed OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1

# Optional JSON object passed as OpenAI SDK extra_body on chat requests.
# Example for some reasoning endpoints: {"reasoning":{"enabled":false}}
LLM_EXTRA_BODY_JSON=

# Optional. Set this for private or rate-limited Hugging Face Hub access.
HF_TOKEN=
